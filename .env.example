# EmailJS Production Configuration
# Replace these placeholder values with your real EmailJS credentials:
# 1. Sign in to https://dashboard.emailjs.com/
# 2. Get Service ID from Email Services
# 3. Get Template ID from Email Templates
# 4. Get Public Key from Account > API Keys

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
